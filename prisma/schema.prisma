// Производител.net — схема на базата данни
// PostgreSQL (Neon в облака). За Neon: DATABASE_URL = pooled връзка,
// DIRECT_URL = директна връзка (за миграции / db push).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
//  Потребители и автентикация
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  // "producer" — земеделски производител | "customer" — купувач | "admin"
  role         String   @default("producer")
  banned       Boolean  @default(false)
  // Приемане на Общите условия при регистрация (доказателство за съгласие)
  termsAcceptedAt DateTime?
  termsVersion    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  producer Producer?
  reports  Report[] @relation("ReportAuthor")
  reviews  Review[]  @relation("ReviewAuthor")

  conversations Conversation[] @relation("CustomerConversations")
  messages      Message[]      @relation("SentMessages")
  purchases     Purchase[]     @relation("CustomerPurchases")
  forumTopics   ForumTopic[]   @relation("ForumTopics")
  forumPosts    ForumPost[]    @relation("ForumPosts")
  blogPosts     BlogPost[]     @relation("BlogPosts")
  orders        Order[]        @relation("CustomerOrders")

  @@index([role])
}

// ─────────────────────────────────────────────
//  Профил на производителя
// ─────────────────────────────────────────────

model Producer {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Основни данни
  urn                 String?   // Уникален регистрационен номер (зелен картон на ЗП)
  urnVerified         Boolean   @default(false) // Потвърден от администратор
  urnDocumentUrl      String?   // Снимка или PDF на регистрационната карта
  urnVerificationNote String?   // Бележка от администратора
  urnVerifiedAt       DateTime? // Дата на потвърждение
  farmName            String
  slug                String    @unique
  ownerName   String
  description String? // Кратко представяне на стопанството

  // Локация
  region String? // Област
  town   String? // Град / село

  // Контакти
  phone        String?
  contactEmail String?
  website      String?

  // Обобщени данни от въпросника
  startedYear  Int? // От коя година се занимават със земеделие
  totalDecares Float? // Обща обработваема площ (декари)

  // Визуална идентичност
  logoUrl        String?
  coverUrl       String? // Снимка на площта (напр. градина) за корица
  coverPosition  Int?    @default(50) // Позиция по вертикала (Y) в проценти (0-100)
  coverPositionX Int?    @default(50) // Позиция по хоризонтала (X) в проценти (0-100)
  coverScale     Int?    @default(100) // Мащаб / приближаване в проценти (100-300)

  // Съвместно пазаруване / доставка
  sharedDelivery Boolean @default(false)

  // Доставчици, с които работи (кодове, разделени със запетая): econt,speedy,pigeon,personal
  deliveryProviders String?

  // Stripe Connect — плащане с карта директно към производителя
  stripeAccountId      String? // acct_... на свързания акаунт
  // Готов ли е акаунтът да получава преводи от платформата (capability
  // "transfers" е active). Името е историческо — виж canReceiveTransfers().
  stripeChargesEnabled Boolean @default(false)

  // Статистика
  visits      Int   @default(0)
  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)

  // Настройка дали профилът е публикуван
  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  crops         Crop[]
  photos        Photo[]
  listings      ProductListing[]
  payment       PaymentSettings?
  reviews         Review[]          @relation("ReviewTarget")
  conversations   Conversation[]
  purchases       Purchase[]
  partnersSelected ProducerPartner[] @relation("PartnerFrom")
  partneredBy      ProducerPartner[] @relation("PartnerTo")
  orders          Order[]

  @@index([region])
  @@index([town])
  @@index([sharedDelivery])
}

// Култура / продукция (какво, от кога, сортове, декари, годишна продукция)
model Crop {
  id         String   @id @default(cuid())
  producerId String
  producer   Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)

  name        String // Напр. "Ягоди", "Домати"
  category    String? // плодове / зеленчуци / зърнени / млечни / мед / друго
  varieties   String? // Сортове или видове (свободен текст)
  sinceYear   Int? // От коя година се произвежда тази култура
  decares     Float? // Площ за тази култура (декари)
  annualYield Float? // Годишна продукция (количество)
  yieldUnit   String? // Мерна единица: кг / тона / бр / литра
  notes       String?

  createdAt DateTime @default(now())

  @@index([producerId])
}

// Снимки на профила (площ, продукти, галерия)
model Photo {
  id         String   @id @default(cuid())
  producerId String
  producer   Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)

  url     String
  // "field" — площ/градина | "product" — продукция | "gallery" — общи
  type    String  @default("gallery")
  caption String?
  sort    Int     @default(0)

  createdAt DateTime @default(now())

  @@index([producerId, type])
}

// ─────────────────────────────────────────────
//  Каталог с продукти за продажба
// ─────────────────────────────────────────────

model ProductListing {
  id         String   @id @default(cuid())
  producerId String
  producer   Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)

  slug        String
  title       String
  description String?
  category    String?

  price    Float
  oldPrice Float? // За оферти / намаления
  unit     String  @default("кг") // кг / бр / връзка / литър / кашон
  currency String  @default("EUR") // Сайтът работи само в евро

  available Boolean @default(true)
  isOffer   Boolean @default(false)
  soldOut   Boolean @default(false) // Изчерпан — обявата се вижда, но не може да се купи
  stockNote String? // Напр. сезонна наличност

  // Подсилване (платено промотиране на началната страница и в каталога)
  boostedAt    DateTime? // Кога е активирано текущото подсилване
  boostedUntil DateTime? // До кога е платено подсилването

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos ListingPhoto[]
  boosts ListingBoost[]

  @@unique([producerId, slug])
  @@index([category])
  @@index([available])
  @@index([soldOut])
  @@index([boostedUntil])
}

// Платено подсилване на обява — таксата постъпва при платформата.
model ListingBoost {
  id        String         @id @default(cuid())
  listingId String
  listing   ProductListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  producerId String

  plan     String // week | days15 | month
  days     Int
  amount   Int    // в евроцентове
  currency String @default("eur")

  stripeSessionId String  @unique
  paymentIntentId String?

  status   String    @default("pending") // pending | paid | cancelled
  startsAt DateTime?
  endsAt   DateTime?

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  @@index([listingId])
  @@index([producerId])
  @@index([status])
}

model ListingPhoto {
  id        String         @id @default(cuid())
  listingId String
  listing   ProductListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  url  String
  sort Int    @default(0)

  @@index([listingId])
}

// ─────────────────────────────────────────────
//  Начини на плащане
// ─────────────────────────────────────────────

model PaymentSettings {
  id         String   @id @default(cuid())
  producerId String   @unique
  producer   Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)

  // Банков превод
  acceptsBankTransfer Boolean @default(false)
  bankName            String?
  bankIban            String?
  bankHolder          String? // Титуляр на сметката

  // Revolut
  acceptsRevolut Boolean @default(false)
  revolutLink    String? // Линк към Revolut профил / .me страница

  // Наложен платеж
  acceptsCod Boolean @default(false)
  codNote    String? // Напр. с коя куриерска фирма

  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
//  Оценки (само от купувачи)
// ─────────────────────────────────────────────

// ─────────────────────────────────────────────
//  Съобщения (чат клиент → производител)
// ─────────────────────────────────────────────

model Conversation {
  id         String   @id @default(cuid())
  producerId String
  producer   Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)
  customerId String
  customer   User     @relation("CustomerConversations", fields: [customerId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  messages Message[]

  @@unique([producerId, customerId])
  @@index([customerId])
  @@index([producerId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  body   String
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([conversationId])
}

// Потвърдена покупка — производителят потвърждава, че клиентът е купувал от него.
// Отключва възможността този клиент да остави оценка.
model Purchase {
  id         String   @id @default(cuid())
  producerId String
  producer   Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)
  customerId String
  customer   User     @relation("CustomerPurchases", fields: [customerId], references: [id], onDelete: Cascade)

  note      String?
  createdAt DateTime @default(now())

  @@unique([producerId, customerId])
  @@index([producerId])
  @@index([customerId])
}

// Насочен избор за партньорство. Взаимен избор (A→B и B→A) = активно партньорство.
model ProducerPartner {
  id         String   @id @default(cuid())
  producerId String
  partnerId  String
  producer   Producer @relation("PartnerFrom", fields: [producerId], references: [id], onDelete: Cascade)
  partner    Producer @relation("PartnerTo", fields: [partnerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([producerId, partnerId])
  @@index([partnerId])
}

// ─────────────────────────────────────────────
//  Поръчки (платени с карта през Stripe)
// ─────────────────────────────────────────────

model Order {
  id         String   @id @default(cuid())
  producerId String
  producer   Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)
  customerId String?
  customer   User?    @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: SetNull)

  stripeSessionId String  @unique
  paymentIntentId String?
  transferId      String? // при съвместно плащане — трансфер към производителя
  groupId         String? // общ идентификатор при съвместна поръчка
  combined        Boolean @default(false)

  amountTotal    Int // в евроцентове
  applicationFee Int     @default(0) // реално удържана комисиона (евроцентове)
  // Комисиона, която БИ се дължала, но не се събира — при наложен платеж
  // парите минават през куриера и платформата няма допир до тях. Служи само
  // за отчет: колко оборот минава извън картовите плащания.
  notionalFee    Int     @default(0)
  currency       String  @default("eur")

  // Платежен статус
  paymentMethod String @default("card") // card | cod | bank | revolut
  paymentStatus String @default("paid") // paid | pending
  status        String @default("paid")

  // Данни за клиента и доставката
  customerName    String?
  email           String?
  phone           String?
  shippingAddress String?

  // Изпълнение (проследяване от производителя)
  fulfillmentStatus String  @default("new") // new | processing | shipped | delivered | cancelled
  courier           String?
  trackingNote      String?

  // Кога сумата е преведена на производителя (след „доставена")
  paidOutAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([producerId])
  @@index([customerId])
  @@index([producerId, fulfillmentStatus])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  title     String
  unitPrice Int // стотинки
  qty       Int
}

// ─────────────────────────────────────────────
//  Доклади (сигнали от потребители)
// ─────────────────────────────────────────────

model Report {
  id          String  @id @default(cuid())
  reporterId  String?
  reporter    User?   @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: SetNull)

  targetType  String // producer | user | listing | topic
  targetId    String
  targetLabel String? // за показване в админ (напр. име на стопанство)
  reason      String
  note        String?

  status     String    @default("open") // open | resolved
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status])
  @@index([targetType, targetId])
}

// ─────────────────────────────────────────────
//  Блог
// ─────────────────────────────────────────────

model BlogPost {
  id       String  @id @default(cuid())
  title    String
  slug     String  @unique
  excerpt  String?
  body     String
  coverUrl String?
  category String

  authorId String
  author   User   @relation("BlogPosts", fields: [authorId], references: [id], onDelete: Cascade)

  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([published])
}

// ─────────────────────────────────────────────
//  Форум
// ─────────────────────────────────────────────

model ForumTopic {
  id       String @id @default(cuid())
  title    String
  slug     String @unique
  category String
  body     String

  authorId String
  author   User   @relation("ForumTopics", fields: [authorId], references: [id], onDelete: Cascade)

  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastReplyAt DateTime @default(now())

  posts ForumPost[]

  @@index([category])
  @@index([lastReplyAt])
}

model ForumPost {
  id      String     @id @default(cuid())
  topicId String
  topic   ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("ForumPosts", fields: [authorId], references: [id], onDelete: Cascade)

  body      String
  createdAt DateTime @default(now())

  @@index([topicId])
}

model Review {
  id         String   @id @default(cuid())
  producerId String
  producer   Producer @relation("ReviewTarget", fields: [producerId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  rating  Int // 1..5
  comment String?
  // Дали покупката е потвърдена от производителя (тъй като плащането е извън платформата)
  verified Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([producerId, authorId])
  @@index([producerId])
}
