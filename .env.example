# Копирайте този файл като „.env" и попълнете стойностите.

# ── База данни (PostgreSQL, напр. Neon) ─────────────────────────────
# DATABASE_URL — pooled връзка (за приложението)
# DIRECT_URL   — директна връзка (за миграции / db push)
# Neon ги дава и двете в раздела „Connection Details".
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ── Автентикация (NextAuth) ─────────────────────────────────────────
# Генерирайте дълъг случаен низ, напр.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="сменете-ме-с-дълъг-случаен-низ"
AUTH_TRUST_HOST=true

# ── Адрес на сайта ──────────────────────────────────────────────────
# Официалният домейн е https://www.proizvoditel.net и се използва
# автоматично при production билд във Vercel. Задайте изрично само ако
# сайтът работи на друг адрес.
# NEXT_PUBLIC_SITE_URL="https://www.proizvoditel.net"

# ── Качване на снимки в облака (по избор) ───────────────────────────
# Задава се автоматично от Vercel, когато включите „Blob" storage.
# Локално не е нужно — снимките се пазят във файловата система.
# BLOB_READ_WRITE_TOKEN="..."

# ── Stripe (плащане с карта / Connect) ──────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
# Тайна на webhook-а за акаунта на платформата (поръчки + подсилване)
STRIPE_WEBHOOK_SECRET="whsec_..."
# Тайна на Connect webhook-а (статус на свързаните производители).
# Stripe изисква отделен endpoint за събитията от свързани акаунти.
STRIPE_WEBHOOK_SECRET_CONNECT="whsec_..."
# Комисиона на платформата в проценти
PLATFORM_FEE_PERCENT="5"
# Кой поема банковата такса на Stripe: "producer" (приспада се от превода
# към стопанина, за да останат чисти 5%) или "platform".
STRIPE_FEE_PAYER="producer"
# Тарифата на Stripe, по която се изчислява приспадането.
STRIPE_FEE_PERCENT="1.5"
STRIPE_FEE_FIXED_CENTS="25"
# Забележка: публикуемият ключ (pk_...) НЕ е нужен — ползваме hosted
# Stripe Checkout (пренасочване от сървъра), без Stripe.js в браузъра.

# ── Автоматично събиране на новини (ИИ) ─────────────────────────────
# Ключ за Claude API — https://platform.claude.com
ANTHROPIC_API_KEY="sk-ant-..."
# Тайна за cron-а на Vercel. Vercel я изпраща като Bearer токен, за да не
# може маршрутът /api/cron/news да се вика отвън. Генерира се така:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="дълъг-случаен-низ"
# По подразбиране намереното се публикува веднага. Сложете "false", ако
# предпочитате да го преглеждате като чернова, преди да излезе на сайта.
# NEWS_AI_AUTOPUBLISH="false"

# ── Админ достъп ────────────────────────────────────────────────────
# Имейл(и) с достъп до /admin (разделени със запетая). Акаунтът трябва
# да съществува (регистрирайте се с този имейл).
ADMIN_EMAIL="davida1991@gmail.com"
